{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winmedia.com/schemas/machine-edition/v0.1/manifest.schema.json",
  "title": "Machine Edition Manifest Schema v0.1",
  "type": "object",
  "required": [
    "package_id",
    "title",
    "version",
    "status",
    "scope",
    "formats",
    "license",
    "human_readable_entrypoint",
    "provenance_file"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9\\-_]+)+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$"
    },
    "status": {
      "type": "string",
      "enum": ["developer_preview", "release_candidate", "stable", "deprecated"]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "resolution_levels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["L0", "L1", "L2", "L3", "L4"]
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "human_readable_entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "provenance_file": {
      "type": "string",
      "minLength": 1
    },
    "integrity": {
      "type": "object",
      "description": "Optional map of relative filepaths to SHA-256 hashes",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{64}$"
      }
    }
  },
  "additionalProperties": true
}
